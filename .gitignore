# Godot editor/import cache — regenerated by `godot --import`.
.godot/
*.translation

# Export output — produced by CI, never committed.
build/
*.pck
*.wasm

# Toolchain installed by scripts/bootstrap.sh. The script is the source of
# truth for these; committing them would create a second, drifting definition.
addons/gut/

# Python
__pycache__/
*.py[cod]

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
